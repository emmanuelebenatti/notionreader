# Notion Reader - Environment Variables
# ======================================
# Copy this file to .env.local and fill in your values.
# 
# DEMO MODE: If no variables are set, the app runs with sample data.
# No configuration needed to try it out!

# ─────────────────────────────────────────────────────────────────
# NOTION INTEGRATION (Required for real data)
# ─────────────────────────────────────────────────────────────────

# Your Notion Integration Token
# Get it from: https://www.notion.so/my-integrations
NOTION_API_KEY=

# Your Notion Database ID
# Find it in your database URL: notion.so/workspace/[DATABASE_ID]?v=...
NOTION_DATABASE_ID=

# ─────────────────────────────────────────────────────────────────
# AUTHENTICATION (Optional)
# ─────────────────────────────────────────────────────────────────

# PostgreSQL connection string for user authentication
# Without this, the app runs without login (open access)
# Recommended: Neon (https://neon.tech)
DATABASE_URL=
